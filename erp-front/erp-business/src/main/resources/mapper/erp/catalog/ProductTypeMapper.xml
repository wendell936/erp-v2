<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.erp.catalog.mapper.ProductTypeMapper">
    <resultMap id="ProductTypeResult" type="com.ruoyi.erp.catalog.domain.ProductType">
        <id property="typeId" column="type_id"/>
        <result property="typeName" column="type_name"/>
        <result property="typeCode" column="type_code"/>
        <result property="keywords" column="keywords"/>
        <result property="status" column="status"/>
        <result property="version" column="version"/>
        <result property="lastNumber" column="last_number"/>
        <result property="requestId" column="request_id"/>
        <result property="requestHash" column="request_hash"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time" typeHandler="com.ruoyi.erp.persistence.UtcDateTimeTypeHandler"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time" typeHandler="com.ruoyi.erp.persistence.UtcDateTimeTypeHandler"/>
        <result property="remark" column="remark"/>
    </resultMap>
    <resultMap id="ChangeResult" type="com.ruoyi.erp.catalog.domain.ProductTypeChange">
        <id property="changeId" column="change_id"/>
        <result property="typeId" column="type_id"/>
        <result property="version" column="version"/>
        <result property="operation" column="operation"/>
        <result property="reason" column="reason"/>
        <result property="operator" column="operator"/>
        <result property="changeTime" column="change_time" typeHandler="com.ruoyi.erp.persistence.UtcDateTimeTypeHandler"/>
    </resultMap>
    <sql id="columns">
        type_id,type_name,type_code,keywords,status,version,last_number,
        request_id,request_hash,create_by,create_time,update_by,update_time,remark
    </sql>
    <select id="selectList" resultMap="ProductTypeResult">
        SELECT <include refid="columns"/> FROM erp_product_type
        <where>
            <if test="typeName != null and typeName != ''">
                AND (type_name LIKE CONCAT('%',#{typeName},'%')
                    OR CONVERT(type_code USING utf8mb4) COLLATE utf8mb4_0900_ai_ci LIKE CONCAT('%',#{typeName},'%')
                    OR keywords LIKE CONCAT('%',#{typeName},'%'))
            </if>
            <if test="status != null and status != ''">AND status=#{status}</if>
        </where>
    </select>
    <select id="selectById" resultMap="ProductTypeResult">
        SELECT <include refid="columns"/> FROM erp_product_type WHERE type_id=#{typeId}
    </select>
    <insert id="insertOrFind" useGeneratedKeys="true" keyProperty="typeId">
        INSERT INTO erp_product_type(type_name,type_code,keywords,status,version,
            request_id,request_hash,create_by,create_time,remark)
        VALUES(#{typeName},#{typeCode},#{keywords},'0',0,
            #{requestId},#{requestHash},#{createBy},
            #{createTime,typeHandler=com.ruoyi.erp.persistence.UtcDateTimeTypeHandler},#{remark})
        ON DUPLICATE KEY UPDATE type_id=LAST_INSERT_ID(type_id)
    </insert>
    <update id="update">
        UPDATE erp_product_type SET type_name=#{typeName},type_code=#{typeCode},
            keywords=#{keywords},remark=#{remark},
            version=version+1,update_by=#{updateBy},
            update_time=#{updateTime,typeHandler=com.ruoyi.erp.persistence.UtcDateTimeTypeHandler}
        WHERE type_id=#{typeId} AND version=#{version}
        AND (BINARY type_code=BINARY #{typeCode} OR last_number=0)
    </update>
    <update id="updateStatus">
        UPDATE erp_product_type SET status=#{status},version=version+1,update_by=#{updateBy},
            update_time=#{updateTime,typeHandler=com.ruoyi.erp.persistence.UtcDateTimeTypeHandler}
        WHERE type_id=#{typeId} AND version=#{version}
    </update>
    <sql id="changeValues">
        INSERT INTO erp_product_type_change(type_id,version,operation,reason,operator,change_time)
        VALUES(#{typeId},#{version},#{operation},#{reason},#{operator},
            #{changeTime,typeHandler=com.ruoyi.erp.persistence.UtcDateTimeTypeHandler})
    </sql>
    <insert id="insertChange"><include refid="changeValues"/></insert>
    <insert id="insertCreationChange">
        <include refid="changeValues"/> ON DUPLICATE KEY UPDATE change_id=change_id
    </insert>
    <select id="selectChanges" resultMap="ChangeResult">
        SELECT change_id,type_id,version,operation,reason,operator,change_time
        FROM erp_product_type_change WHERE type_id=#{typeId}
    </select>
</mapper>
