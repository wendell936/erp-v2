<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.erp.supplier.mapper.SupplierMapper">
    <resultMap id="SupplierResult" type="com.ruoyi.erp.supplier.domain.Supplier">
        <id property="supplierId" column="supplier_id"/>
        <result property="supplierName" column="supplier_name"/>
        <result property="contactName" column="contact_name"/>
        <result property="contactPhone" column="contact_phone"/>
        <result property="settlementTerms" column="settlement_terms"/>
        <result property="status" column="status"/>
        <result property="version" column="version"/>
        <result property="requestId" column="request_id"/>
        <result property="requestHash" column="request_hash"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time" typeHandler="com.ruoyi.erp.persistence.UtcDateTimeTypeHandler"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time" typeHandler="com.ruoyi.erp.persistence.UtcDateTimeTypeHandler"/>
        <result property="remark" column="remark"/>
    </resultMap>
    <resultMap id="ChangeResult" type="com.ruoyi.erp.supplier.domain.SupplierChange">
        <id property="changeId" column="change_id"/>
        <result property="supplierId" column="supplier_id"/>
        <result property="version" column="version"/>
        <result property="operation" column="operation"/>
        <result property="reason" column="reason"/>
        <result property="operator" column="operator"/>
        <result property="changeTime" column="change_time" typeHandler="com.ruoyi.erp.persistence.UtcDateTimeTypeHandler"/>
    </resultMap>
    <sql id="columns">
        supplier_id,supplier_name,contact_name,contact_phone,settlement_terms,status,version,
        request_id,request_hash,create_by,create_time,update_by,update_time,remark
    </sql>
    <select id="selectList" resultMap="SupplierResult">
        SELECT <include refid="columns"/> FROM erp_supplier
        <where>
            <if test="supplierName != null and supplierName != ''">AND supplier_name LIKE CONCAT('%',#{supplierName},'%')</if>
            <if test="status != null and status != ''">AND status=#{status}</if>
        </where>
    </select>
    <select id="selectById" resultMap="SupplierResult">
        SELECT <include refid="columns"/> FROM erp_supplier WHERE supplier_id=#{supplierId}
    </select>
    <insert id="insertOrFind" useGeneratedKeys="true" keyProperty="supplierId">
        INSERT INTO erp_supplier(supplier_name,contact_name,contact_phone,settlement_terms,status,version,
            request_id,request_hash,create_by,create_time,remark)
        VALUES(#{supplierName},#{contactName},#{contactPhone},#{settlementTerms},'0',0,
            #{requestId},#{requestHash},#{createBy},
            #{createTime,typeHandler=com.ruoyi.erp.persistence.UtcDateTimeTypeHandler},#{remark})
        ON DUPLICATE KEY UPDATE supplier_id=LAST_INSERT_ID(supplier_id)
    </insert>
    <update id="update">
        UPDATE erp_supplier SET supplier_name=#{supplierName},contact_name=#{contactName},
            contact_phone=#{contactPhone},settlement_terms=#{settlementTerms},remark=#{remark},
            version=version+1,update_by=#{updateBy},
            update_time=#{updateTime,typeHandler=com.ruoyi.erp.persistence.UtcDateTimeTypeHandler}
        WHERE supplier_id=#{supplierId} AND version=#{version}
    </update>
    <update id="updateStatus">
        UPDATE erp_supplier SET status=#{status},version=version+1,update_by=#{updateBy},
            update_time=#{updateTime,typeHandler=com.ruoyi.erp.persistence.UtcDateTimeTypeHandler}
        WHERE supplier_id=#{supplierId} AND version=#{version}
    </update>
    <sql id="changeValues">
        INSERT INTO erp_supplier_change(supplier_id,version,operation,reason,operator,change_time)
        VALUES(#{supplierId},#{version},#{operation},#{reason},#{operator},
            #{changeTime,typeHandler=com.ruoyi.erp.persistence.UtcDateTimeTypeHandler})
    </sql>
    <insert id="insertChange"><include refid="changeValues"/></insert>
    <insert id="insertCreationChange">
        <include refid="changeValues"/> ON DUPLICATE KEY UPDATE change_id=change_id
    </insert>
    <select id="selectChanges" resultMap="ChangeResult">
        SELECT change_id,supplier_id,version,operation,reason,operator,change_time
        FROM erp_supplier_change WHERE supplier_id=#{supplierId}
    </select>
</mapper>
